filters:
  and:
    - file.hasTag("documentacao-oficial")
    - status != "done"
    - status != "concluido"
    - '!file.hasTag("archived")'
formulas:
  checklistProgress: file.tasks.filter(value.checked).length + "/" + file.tasks.length
views:
  - type: tasknotesKanban
    name: Documentação — 2 cards
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - priority
      - due
      - file.tasks
      - file.name
    sort:
      - property: due
        direction: ASC
    config:
      columnWidth: 420
      hideEmptyColumns: true
  - type: table
    name: Checklist — progresso
    order:
      - file.name
      - status
      - priority
      - due
      - file.tasks
      - formula.checklistProgress
    sort:
      - property: file.name
        direction: ASC
