filters:
  and:
    - file.hasTag("task")
    - file.ext == "md"
formulas:
  status_icon: if(status.contains("done") || status.contains("completed") || status.contains("approved") || status.contains("concluido"), "✅", if(status.contains("blocked") || status.contains("bloqueado"), "⛔", if(status.contains("in-progress") || status.contains("em-execucao"), "🔄", if(status.contains("em-revisao") || status.contains("conditionally-approved") || status.contains("condicional"), "🔍", "⬜"))))
  dependency_count: dependencies.length
  gap_count: gap_ids.length
  priority_rank: if(priority.contains("critical") || priority.contains("critica"), 1, if(priority.contains("high") || priority.contains("alta"), 2, 3))
properties:
  task_id:
    displayName: Task ID
  status:
    displayName: Status
  priority:
    displayName: Priority
  area:
    displayName: Workstream
  layer:
    displayName: Layer
  sequence:
    displayName: Sequence
  owner:
    displayName: Owner
  target_file:
    displayName: Blueprint Output
  dependencies:
    displayName: Dependencies
  gap_ids:
    displayName: Gap IDs
  formula.status_icon:
    displayName: State
  formula.dependency_count:
    displayName: Dependencies (#)
  formula.gap_count:
    displayName: Gaps (#)
  formula.priority_rank:
    displayName: Priority Rank
views:
  - type: table
    name: Blueprint Task Register
    order:
      - file.name
      - task_id
      - projects
      - status
      - priority
      - owner
      - area
      - target_file
      - gap_ids
      - type
    sort:
      - property: status
        direction: ASC
    columnSize:
      file.name: 342
      note.projects: 258
      note.priority: 107
      note.gap_ids: 636
  - type: table
    name: Work Queue
    filters:
      and:
        - '!(status.contains("done") || status.contains("completed") || status.contains("approved") || status.contains("concluido"))'
    order:
      - formula.priority_rank
      - sequence
      - task_id
      - file.name
      - status
      - priority
      - dependencies
      - gap_ids
  - type: table
    name: Dependency View
    order:
      - sequence
      - task_id
      - file.name
      - dependencies
      - formula.dependency_count
      - status
      - target_file
  - type: table
    name: Blocked and Review
    filters:
      or:
        - status.contains("blocked") || status.contains("bloqueado")
        - status.contains("em-revisao") || status.contains("conditionally-approved") || status.contains("condicional")
    order:
      - task_id
      - file.name
      - status
      - priority
      - gap_ids
      - target_file
  - type: cards
    name: Blueprint Workstreams
    order:
      - file.name
      - formula.status_icon
      - area
      - priority
      - target_file
      - gap_ids
  - type: canvas-bases
    name: Blueprint Board
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - task_id
      - formula.status_icon
      - priority
      - area
      - owner
      - dependencies
      - gap_ids
    sort:
      - property: formula.priority_rank
        direction: ASC
      - property: sequence
        direction: ASC
    canvasBasesLayout: grid
    canvasBasesEdgeMode: properties
    canvasBasesEdgeProperties: dependencies, gap_ids
    canvasBasesShowBodyEditor: false
    canvasBasesNodeWidth: 380
    canvasBasesNodeHeight: 220
    canvasBasesLinkedCanvasPath: 04-project-management/tarefas/HUB_Tarefas_Projeto.canvas
    canvasBasesPreservePositions: true
    canvasBasesRemoveMissingNodes: true
    canvasBasesTaskNotesMode: off
    canvasBasesNodePositions:
      canvas-bases-file-1isa5lm:
        x: 395
        y: 710
        width: 380
        height: 220
      canvas-bases-file-1c6wvdq:
        x: 0
        y: 0
        width: 380
        height: 220
